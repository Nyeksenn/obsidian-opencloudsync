#!/bin/sh
# [opencloud-fork] Release-hygiene gate for the OpenCloud Sync Obsidian plugin.
#
# Runs before every `git push` (wired up via core.hooksPath, set by the package.json "prepare" script on
# `pnpm install`). It blocks a push when:
#   1. the Obsidian community-store linter reports errors (eslint-plugin-obsidianmd);
#   2. the type-check + production build fails;
#   3. README.md does not name the manifest.json version in its
#      "What's new" heading, or does not mention minAppVersion;
#   4. a stable release (plain x.y.z) has no "[x.y.z]" entry in CHANGELOG.md;
#   5. the unit tests (`pnpm test`) fail;
#   6. the live OpenCloud tests (`pnpm test:oc`) fail. They need the local server from compose.yml; when it is not
#      running (exit 3), they are skipped with a notice instead of blocking the push.
#
# Bypass in an emergency with: git push --no-verify
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-push: Obsidian community-store lint…"
pnpm lint

echo "pre-push: type-check + production build…"
pnpm build

VERSION="$(node -p "require('./manifest.json').version")"
MIN_APP="$(node -p "require('./manifest.json').minAppVersion")"
README="README.md"

if ! grep -qF "($VERSION)" "$README"; then
  echo "pre-push: $README has no \"What's new\" heading for version $VERSION." >&2
  echo "          Update its release notes to match manifest.json version $VERSION (or push with --no-verify)." >&2
  exit 1
fi
if ! grep -qF "$MIN_APP" "$README"; then
  echo "pre-push: $README does not mention minAppVersion $MIN_APP from manifest.json." >&2
  exit 1
fi

case "$VERSION" in
  *-*)
    echo "pre-push: $VERSION is a pre-release — skipping the CHANGELOG check."
    ;;
  *)
    if ! grep -qF "[$VERSION]" CHANGELOG.md; then
      echo "pre-push: CHANGELOG.md has no entry for stable version $VERSION." >&2
      echo "          Add a '## [$VERSION] - YYYY-MM-DD' section and a '[$VERSION]: …' link (or push with --no-verify)." >&2
      exit 1
    fi
    ;;
esac

echo "pre-push: unit tests…"
pnpm test

echo "pre-push: live OpenCloud tests…"
rc=0
bash tests/opencloud-live/run.sh || rc=$?
case "$rc" in
  0) echo "pre-push: lint, build, README, CHANGELOG, unit and live tests passed." ;;
  3) echo "pre-push: live OpenCloud tests SKIPPED — no local server (start it with: podman-compose up -d)." ;;
  *) exit "$rc" ;;
esac
